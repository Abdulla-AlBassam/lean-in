# Copy to .env and fill in. Each teammate's key is its own var so we can round-robin.
ANTHROPIC_API_KEY_ABDULLA=sk-ant-...
ANTHROPIC_API_KEY_SALIHA=sk-ant-...
ANTHROPIC_API_KEY_MAKS=sk-ant-...
ANTHROPIC_API_KEY_ELYA=sk-ant-...
ANTHROPIC_API_KEY_AWS=sk-ant-...

# Toggle to true to serve cached responses from demo_cache/ instead of hitting Anthropic.
# Flip ON before the demo. Off during dev.
DEMO_MODE=false
